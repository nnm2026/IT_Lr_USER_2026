$(function(){

	function build_contents() {
		var contents =3D '';
		var id_counter =3D 0;

		var stack =3D new Array;
		stack.push ({
			level: 0
		});

		function update_stack_level (item) {
			while (stack.length > 0 && stack[stack.length-1].level >=3D =
item.level)
				close_item (stack.pop());
			if (stack.length > 0)
				start_list (stack[stack.length-1]);
			start_item (item);
			stack.push (item);
		}

		function start_item (item) {
			contents +=3D "<li><a href=3D\"#" + item.id + "\">" + item.title + =
"</a></li>";
		}
		function start_list (item) {
			if (item.list_started)  return;
			contents +=3D "<ul>";
			item.list_started =3D true;
		}
		function close_item (item) {
			if (item.list_started)
				contents +=3D "</ul>";
		}

		$('td.content').find('h1, h2, h3, h4').each(function(){
			var level =3D this.tagName[1];
			var title =3D $(this).html();
			var id =3D id_counter++;

			$(this).before ('<a name=3D"' + id + '"></a>');
			$(this).attr ('id', 'header_' + id);
		=09
			update_stack_level ({
				level: level,
				title: title,
				id: id
			});
		});
		while (stack.length > 0)
			close_item (stack.pop());

		$('#contents-table > div').html (contents);
		$('#contents-table > div').slideDown();
	}

	build_contents();



	$('#contents-table a').click(function(){
		var sel =3D '#header_' + $(this).attr('href').substr(1);
		var elem =3D $(sel);
		var current_color =3D elem.css ('color');
		elem.css('color','rgb(0, 0, 187)');
		setTimeout (function(){
			elem.css('color',current_color);
		}, 300);
	});


	$('#contents-hide').click(function(){
		$(this).parent().parent().find('div').slideUp();
		$('#contents-hide').hide();
		$('#contents-show').show();
		return false;
	});
	$('#contents-show').click(function(){
		$(this).parent().parent().find('div').slideDown();
		$('#contents-show').hide();
		$('#contents-hide').show();
		return false;
	});

});


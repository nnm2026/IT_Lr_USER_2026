		m2.className=3D'menu_collections_vis'+s;
	}
	if(menu_selected_a) {
		//alert ('!!!');
		menu_selected_a.className=3D'active'+s;
	}
}

function menu_go(no) {
	var m =3D document.getElementById('menu_'+no);
	if(!m) 	return;
	var sm =3D document.getElementById('cmenu_'+no);
	if(!sm)	sm =3D document.getElementById('cmenu_default');

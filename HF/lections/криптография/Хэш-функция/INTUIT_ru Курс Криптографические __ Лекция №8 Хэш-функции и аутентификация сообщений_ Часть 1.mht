var menu_items =3D new Array("courses", "education", "school", "shop", =
"work", "communication", "news", "news_rss", "help");

function menu_find_menu2selected(href) {

	href=3Dhref.replace(/\/w2k-bin\/poem\/cart.cgi(\?.*)?$/,'/user/cart/');


	for(var i=3D0; i<menu_items.length; ++i) {
		var n =3D menu_items[i];
		var ms =3D menu_go(n);
		if(ms) {
			var m =3D ms[1];
			var els =3D m.getElementsByTagName('a');
			for(var j=3D0; j<els.length; ++j) {
				var a =3D els[j];
				if(a.href =3D=3D href) {
					menu_selected_topic=3Dn;
					menu_selected_a=3Da;
					return [n,a];
				}
			}
		}
	}
	return;
}

function menu_clearTimeout() {
	if(!menu_timeID) return;
	clearTimeout(menu_timeID);
	menu_timeID =3D 0;
}

function menu_setTimeout() {
	menu_clearTimeout();
	menu_timeID =3D setTimeout( "menu_reset()", menu_delay_time );
}

function menu_main() {
	if(menu_main_item) return menu_main_item;
	menu_main_item =3D 'courses';
	var href =3D window.document.location.href;
	href=3Dhref.replace(/^http:\/\/www\.intuit\.ru\//,'/');
	menu_href=3Dhref;
	var aselected =3D =
menu_find_menu2selected(window.document.location.href);
	if(aselected) {
		menu_main_item=3Daselected[0];
		return menu_main_item;
	}
	if(href.match(/^\/(speciality|groups)\//)) {
		menu_main_item =3D 'education';
		return menu_main_item;
	}
	if(href.match(/^\/news\//)) {
		menu_main_item =3D 'news';
		return menu_main_item;
	}

	if(href.match(/^(\/help\/askform.xhtml|\/rating_students\/)/)) {
		menu_main_item =3D 'communication';
		return menu_main_item;
	}
	if(href.match(/^\/help\//)) {
		menu_main_item =3D 'help';
		return menu_main_item;
	}
	if(href.match(/^\/shop\//)) {
		menu_main_item =3D 'shop';
		return menu_main_item;
	}
	if(href.match(/^\/user\/(account|cart)\//)) {
		menu_main_item =3D 'shop';
		return menu_main_item;
	}
	if(href.match(/^\/school/)) {
		menu_main_item =3D 'school';
		return menu_main_item;
	}
	return menu_main_item;
}



function menu_reset() {
	menu_clearTimeout();
	menu_set(menu_main());
}

function menu_set(no) {
	for(var i=3D0; i<menu_items.length; ++i) {
		var n =3D menu_items[i];
		var ms =3D menu_go(n);
		if(ms) {
			var m =3D ms[0];
			var m2 =3D ms[1];
			var s =3D '';
			if(n =3D=3D 'work') {
				s =3D '_new';
